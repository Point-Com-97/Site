# ============================================================
# .htaccess uploads - Interdiction totale d'exécution de scripts
# ============================================================

# Désactiver le moteur PHP dans ce dossier
php_flag engine off

# Interdire tous les fichiers exécutables
<FilesMatch "\.(php|php3|php4|php5|phtml|phar|inc|cgi|pl|py|sh|asp|aspx|jsp)$">
    Require all denied
</FilesMatch>

# Forcer le téléchargement pour les types non sûrs (optionnel)
# <FilesMatch "\.(pdf)$">
#     ForceType application/octet-stream
#     Header set Content-Disposition attachment
# </FilesMatch>

# Désactiver l'affichage des répertoires
Options -Indexes

# Interdire l'accès aux fichiers cachés
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
