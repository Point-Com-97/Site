# ============================================================
# .htaccess admin - Protection renforcée de l'administration
# ============================================================

# Désactiver l'affichage des répertoires
Options -Indexes

# Interdire l'accès aux fichiers sensibles
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Bloquer les requêtes suspectes
RewriteEngine On
RewriteCond %{QUERY_STRING} (<|%3C)([^s]*s)+cript.*(>|%3E) [NC,OR]
RewriteCond %{QUERY_STRING} GLOBALS(=|\[|%[0-9A-Z]{0,2}) [OR]
RewriteCond %{QUERY_STRING} _REQUEST(=|\[|%[0-9A-Z]{0,2})
RewriteRule ^ - [F,L]

# Limiter les méthodes HTTP autorisées (GET et POST uniquement)
<LimitExcept GET POST>
    Require all denied
</LimitExcept>
